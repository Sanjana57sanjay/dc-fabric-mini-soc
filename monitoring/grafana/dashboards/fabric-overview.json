{
  "uid": "fabric-overview",
  "title": "Fabric Overview",
  "tags": ["fabric", "bgp", "evpn"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "BGP sessions established",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(frr_bgp_peer_state == 1) or vector(0)" }],
      "fieldConfig": { "defaults": {
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 16 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2, "type": "stat", "title": "BGP sessions NOT established",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(frr_bgp_peer_state != 1) or vector(0)" }],
      "fieldConfig": { "defaults": {
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 3, "type": "stat", "title": "Fabric exporters up (of 8)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=~\"frr|fabric-netdev\"})" }],
      "fieldConfig": { "defaults": {
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 8 } ] }
      }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 4, "type": "state-timeline", "title": "BGP session state (per router, per peer, per family)",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "frr_bgp_peer_state", "legendFormat": "{{instance}} -> {{peer}} ({{afi}})" }],
      "fieldConfig": { "defaults": {
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "Down", "color": "red", "index": 0 },
          "1": { "text": "Established", "color": "green", "index": 1 },
          "2": { "text": "Admin down", "color": "orange", "index": 2 } } }]
      }, "overrides": [] },
      "options": { "showValue": "never", "rowHeight": 0.8, "mergeValues": true, "legend": { "showLegend": false } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Underlay link throughput (TX)",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(node_network_transmit_bytes_total{job=\"fabric-netdev\",device=~\"eth1|eth2\"}[1m]) * 8", "legendFormat": "{{instance}} {{device}}" }],
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 6, "type": "timeseries", "title": "leaf1 ECMP split (eth1 -> spine1, eth2 -> spine2)",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(node_network_transmit_bytes_total{job=\"fabric-netdev\",instance=\"leaf1\",device=~\"eth1|eth2\"}[1m]) * 8", "legendFormat": "leaf1 {{device}}" }],
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"] } }
    },
    {
      "id": 7, "type": "timeseries", "title": "VXLAN overlay traffic (vxlan10010)",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_transmit_bytes_total{job=\"fabric-netdev\",device=\"vxlan10010\"}[1m]) * 8", "legendFormat": "{{instance}} TX" },
        { "refId": "B", "expr": "rate(node_network_receive_bytes_total{job=\"fabric-netdev\",device=\"vxlan10010\"}[1m]) * 8", "legendFormat": "{{instance}} RX" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Prefixes received per peer",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "frr_bgp_peer_prefixes_received_count_total", "legendFormat": "{{instance}} <- {{peer}} ({{afi}})" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Interface drops (RX + TX, packets/s)",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (instance, device) (rate(node_network_receive_drop_total{job=\"fabric-netdev\"}[1m]) + rate(node_network_transmit_drop_total{job=\"fabric-netdev\"}[1m]))", "legendFormat": "{{instance}} {{device}}" }],
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
