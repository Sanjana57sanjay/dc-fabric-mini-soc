# dc-fabric-mini-soc local rules (SID range 9000000-9000999)

# 9000001 - pipeline test: tenant ping across the VXLAN overlay (max 1 alert/min per source)
alert icmp $TENANT_NET any -> $TENANT_NET any (msg:"FABRIC TEST tenant ICMP echo across VXLAN"; itype:8; threshold: type limit, track by_src, count 1, seconds 60; classtype:misc-activity; sid:9000001; rev:1;)

# 9000002 - BGP connection attempt to the underlay from outside the underlay
alert tcp !$UNDERLAY_NET any -> $UNDERLAY_NET $BGP_PORTS (msg:"FABRIC BGP SYN from non-underlay source"; flow:to_server; flags:S,12; classtype:attempted-recon; sid:9000002; rev:1;)

# 9000003 - VXLAN traffic from an address that is not a known VTEP
alert udp !$VTEP_NET any -> $VTEP_NET $VXLAN_PORTS (msg:"FABRIC VXLAN packet from non-VTEP source"; classtype:policy-violation; sid:9000003; rev:1;)

# 9000004 - local equivalent of ET/GPL 2100498 (ET Open not loaded on this sensor)
alert ip any any -> any any (msg:"FABRIC ATTACK_RESPONSE id check returned root"; content:"uid=0|28|root|29|"; classtype:bad-unknown; sid:9000004; rev:1;)
